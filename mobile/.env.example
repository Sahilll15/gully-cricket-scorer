EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# EXPO_PUBLIC_ACCOUNTS=1 turns on phone sign-in and cloud backup
# The Web OAuth client id from Google Cloud; set it to show "Continue with Google"
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com

# Real AdMob ids: leave unset to serve Google test ads
# ADMOB_ANDROID_APP_ID=
# EXPO_PUBLIC_ADMOB_BANNER_ID=
